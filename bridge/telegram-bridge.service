[Unit]
Description=Telegram account bridge for compos
After=network-online.target

[Service]
EnvironmentFile=%h/telegram-bridge/env
Environment=BRIDGE_HOME=%h/telegram-bridge
ExecStart=/usr/bin/env uv run --script %h/telegram-bridge/bridge.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
